{
  "name": "dsh-files-native",
  "description": "DSH 插件:接近原生质感的附件上传——拖入/粘贴/回形针,图片缩略图与文件卡片混排在官方附件栏",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meyaomiao/dsh-files-native.git"
  },
  "homepage": "https://github.com/meyaomiao/dsh-files-native#readme",
  "bugs": {
    "url": "https://github.com/meyaomiao/dsh-files-native/issues"
  },
  "author": "meyaomiao",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "attachments",
    "file-upload"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "screenshots",
    "screenshots.json"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
